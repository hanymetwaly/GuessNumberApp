# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# --- Postgres ---
POSTGRES_DB=guessnumber
POSTGRES_USER=postgres
# Use a strong password in production.
POSTGRES_PASSWORD=change_me_strong_password

# --- JWT (backend) ---
# Must be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_KEY=change_me_super_long_secret_key_at_least_32_chars
JWT_ISSUER=GuessNumberApi
JWT_AUDIENCE=GuessNumberClient

# --- Public address / HTTPS ---
# SITE_ADDRESS is what Caddy binds to and requests a certificate for.
#   Production (real HTTPS): your Azure FQDN, e.g.
#     SITE_ADDRESS=guessnumber-demo.westeurope.cloudapp.azure.com
#   Local testing (plain HTTP, no cert):
#     SITE_ADDRESS=:80
SITE_ADDRESS=:80

# Email used for Let's Encrypt registration (optional but recommended for prod).
TLS_EMAIL=you@example.com

# Full public URL of the site (used for the backend CORS fallback).
#   Production: https://guessnumber-demo.westeurope.cloudapp.azure.com
#   Local:      http://localhost
PUBLIC_URL=http://localhost
